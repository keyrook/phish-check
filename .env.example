# Copy to .env and fill in one provider. .env is gitignored; never commit it.

# groq | cloudflare | openai (any other OpenAI-compatible endpoint)
PROVIDER=groq

# Groq: https://console.groq.com → API Keys
GROQ_API_KEY=

# Cloudflare Workers AI: dashboard → AI → Workers AI → "Use REST API"
# (the token needs the "Workers AI" read permission)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Any other OpenAI-compatible endpoint, e.g. https://example.com/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional: override the provider's default model, and the request rate.
# Defaults: Groq meta-llama/llama-4-scout-17b-16e-instruct,
# Cloudflare @cf/meta/llama-4-scout-17b-16e-instruct; 20 requests a minute.
MODEL=
RPM=
