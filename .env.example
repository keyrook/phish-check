# Copy to .env and fill in one provider. .env is gitignored; never commit it.

# cloudflare | groq | openai (any other OpenAI-compatible endpoint)
PROVIDER=cloudflare

# Cloudflare Workers AI: dashboard → AI → Workers AI → "Use REST API"
# (the token needs the "Workers AI" read permission). Free: 10,000 neurons
# a day, reset at 00:00 UTC.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Groq: https://console.groq.com → API Keys. As of 2026-10-23 Groq no longer
# serves Llama 4 Scout (or any Meta chat model) on free keys.
GROQ_API_KEY=

# Any other OpenAI-compatible endpoint. NVIDIA's API catalog, which serves
# meta/muse-glimmer-30b: https://integrate.api.nvidia.com/v1 and an nvapi- key
# from build.nvidia.com. Select it per run with PROVIDER=openai MODEL=...
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional: override the provider's default model, and the request rate.
# Defaults: Cloudflare @cf/meta/llama-4-scout-17b-16e-instruct,
# Groq meta-llama/llama-4-scout-17b-16e-instruct; 20 requests a minute.
MODEL=
RPM=
